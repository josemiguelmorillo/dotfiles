    name = José Miguel Morillo
    email = josemiguel.morillo@icloud.com

[core]
    editor = vim

[alias]
    # Check current profile
    whoami = "!git config --show-origin user.name && git config --show-origin user.email"
    orphan = "!git branch -vv | awk '/: gone]/{print $1}'"
    cleanup = "!git fetch -p && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -d"


    # Quality-of-life aliases
    st = status
    ci = commit
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate --all
    last = log -1 HEAD

[includeIf "gitdir:~/Projects/clients/tifin/"]
	path = ~/Projects/clients/tifin/.gitconfig-tifin

[includeIf "gitdir:~/Projects/clients/criterian/"]
    path = ~/Projects/clients/criterian/.gitconfig-criterian

