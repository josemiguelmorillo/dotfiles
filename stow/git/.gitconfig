[user]
    name = José Miguel Morillo
    email = josemiguel.morillo@icloud.com

[core]
    editor = vim

[alias]
	# Check current profile
	whoami = "!git config --show-origin user.name && git config --show-origin user.email"
	orphan = "!git branch -vv | awk '/: gone]/{print $1}'"
	cleanup = !git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D

	# Quality-of-life aliases
	st = status
	ci = commit
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate -20
	last = log -1 HEAD
	pltf = pull -t -f
	ptf = push --tags -f
	fa = fetch -ap --tags -f

	# Custom alias: add -u, copy diff and commit
	cdiff = "!f() { git add -u && git diff --staged | pbcopy && git commit \"$@\"; }; f"
	gone = !git branch -vv | awk '/: gone]/{print $1}'
	today = !git log --since=midnight --oneline --author=\"$(git config user.name)\"
	team = log --oneline --graph --decorate --all --since=2.weeks
	who = shortlog -sn --since=1.month
	stale = !git for-each-ref --sort=committerdate refs/remotes --format='%(committerdate:short) %(refname:short)' | awk -v d=\"$(date -v-30d +%F)\" '$1 < d'


[includeIf "gitdir:~/Projects/clients/tifin/"]
	path = ~/.gitconfig-tifin

[includeIf "gitdir:~/Projects/clients/criterian/"]
	path = ~/.gitconfig-criterian

[includeIf "gitdir:~/.codex/worktrees"]
	path = ~/.gitconfig-tifin
[fetch]
	prune = true
	pruneTags = true
